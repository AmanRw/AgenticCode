# Google Gemini API Key (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively: GOOGLE_API_KEY=your_gemini_api_key_here

# Other Providers (Optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_or_app_token
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# LLM Persona Configuration (Gemini Powered)
DEFAULT_LLM_PROVIDER=gemini # gemini | openai | anthropic
DEFAULT_MODEL=gemini-2.5-flash
CODE_READER_MODEL=gemini-2.5-flash
PLANNER_MODEL=gemini-2.5-pro
TEST_WRITER_MODEL=gemini-2.5-flash
CODE_WRITER_MODEL=gemini-2.5-pro

# Hardened Sandbox Settings
SANDBOX_IMAGE=agentic-code-sandbox:latest
SANDBOX_USER=1000:1000
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEM_LIMIT=4096m
SANDBOX_CPU_QUOTA=200000
SANDBOX_NETWORK_MODE=none
ALLOW_LOCAL_FALLBACK_SANDBOX=true

# Orchestrator & Cyclic Repair
MAX_ITERATIONS=3
WORK_DIR=./workspace_runs

# Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=AgenticCode
OTEL_EXPORTER_ENABLED=false
LOG_LEVEL=INFO
